# ============================================================
# docker compose 用的环境变量
#
# 用法：复制本文件为 .env（同目录），把值填成你自己的。
# ⚠️ .env 已在 .gitignore 中，不会进版本库；本文件（.env.example）是模板，可以进。
# ============================================================

# ---------- MySQL ----------
DB_PASSWORD=123456

# ---------- RabbitMQ ----------
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# ---------- 对象存储 RustFS ----------
# ⚠️ 官方提醒：不要使用默认的 rustfsadmin；换一个自己记得住的值
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfspassword

# ---------- 邮件（163 邮箱的 SMTP 授权码，不是登录密码）----------
MAIL_PASSWORD=

# ---------- JWT 签名密钥 ----------
# 换一次，所有已签发的令牌立即失效（用户需要重新登录）
JWT_KEY=

# ---------- AI 服务（阿里百炼）----------
# 留空则 AI 功能提示"尚未配置"，不影响其它功能
AI_API_KEY=
